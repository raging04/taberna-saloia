// Cloudflare Workers (static assets). Build with `npm run build`, then
// `npx wrangler deploy` uploads dist/. Headers live in public/_headers.
{
  "name": "taberna-saloia",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
